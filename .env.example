# Copy this file to .env and edit before starting the native Windows app.
# Keep this file private. Do NOT commit .env.
# Native PostgreSQL (these are for the securaware user, NOT the postgres superuser)
PGHOST=localhost
PGPORT=5432
PGDATABASE=securaware_fresh
PGUSER=securaware
PGPASSWORD=replace-with-your-securaware-db-user-password
# Docker Compose retains its own DATABASE_URL from compose.yaml
POSTGRES_PASSWORD=replace-with-a-strong-value-if-using-docker
BOOTSTRAP_EMAIL=your-real-test-email@example.com
BOOTSTRAP_NAME=Your Full Name
BOOTSTRAP_PASSWORD=replace-with-a-long-random-temporary-password-16plus
PORT=4000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
# SMTP is optional; without it notifications are in-app and campaigns are not emailed.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SecurAware <no-reply@divimaga.example>
